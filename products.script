// Product categories
const categories = [
    { id: 'all', name: 'All Products' },
    { id: 'interior', name: 'Interior Accessories' },
    { id: 'lighting', name: 'Lighting Accessories' },
    { id: 'exterior', name: 'Exterior Accessories' },
    { id: 'care', name: 'Car Care & Fragrance' },
    { id: 'electronics', name: 'Electronic Accessories' }
];

// Helper function to get product by ID
function getProductById(id) {
    return products.find(product => product.id === id);
}

// Helper function to get products by category
function getProductsByCategory(categoryId) {
    if (categoryId === 'all') return products;
    return products.filter(product => product.category === categoryId);
}

// Helper function to search products
function searchProducts(query) {
    const searchTerm = query.toLowerCase().trim();
    if (!searchTerm) return products;
    return products.filter(product =>
        product.name.toLowerCase().includes(searchTerm) ||
        product.description.toLowerCase().includes(searchTerm) ||
        product.category.toLowerCase().includes(searchTerm)
    );
}

// Helper function to filter products by price range
function filterByPrice(minPrice, maxPrice) {
    return products.filter(product => {
        if (product.price === null) return false;
        const price = product.price;
        return price >= minPrice && price <= maxPrice;
    });
}

// Helper function to get products with prices only
function getPricedProducts() {
    return products.filter(product => product.price !== null);
}

// Helper function to format price in Kenyan Shillings
function formatPrice(amount) {
    if (amount === null) return 'Price on request';
    return `KSh ${Number(amount).toLocaleString('en-KE')}`;
}

// Export for use in other modules (if using ES6 modules)
if (typeof module !== 'undefined' && module.exports) {
    module.exports = {
        products,
        categories,
        getProductById,
        getProductsByCategory,
        searchProducts,
        filterByPrice,
        getPricedProducts,
        formatPrice
    };
}

// Make available globally for current setup
window.Products = {
    products,
    categories,
    getProductById,
    getProductsByCategory,
    searchProducts,
    filterByPrice,
    getPricedProducts,
    formatPrice
};
